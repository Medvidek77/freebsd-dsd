+
+static __inline uint64_t
+dsd_read_64le(const uint8_t *src)
+{
+	return ((uint64_t)src[0] | ((uint64_t)src[1] << 8) |
+	    ((uint64_t)src[2] << 16) | ((uint64_t)src[3] << 24) |
+	    ((uint64_t)src[4] << 32) | ((uint64_t)src[5] << 40) |
+	    ((uint64_t)src[6] << 48) | ((uint64_t)src[7] << 56));
+}
+
+static __inline void
+dsd_write_dop64to96le(uint8_t *dst, uint64_t v)
+{
+	dst[0] = v & 0xff;
+	dst[1] = (v >> 8) & 0xff;
+	dst[2] = 0x05;
+	dst[3] = (v >> 32) & 0xff;
+	dst[4] = (v >> 40) & 0xff;
+	dst[5] = 0x05;
+	dst[6] = (v >> 16) & 0xff;
+	dst[7] = (v >> 24) & 0xff;
+	dst[8] = 0xfa;
+	dst[9] = (v >> 48) & 0xff;
+	dst[10] = (v >> 56) & 0xff;
+	dst[11] = 0xfa;
+}

