+static usb_error_t
+uaudio20_set_format(struct usb_device *udev, uint8_t iface_no,
+    uint8_t clockid, uint32_t format)
+{
+	struct usb_device_request req;
+	uint8_t data[8];
+
+	DPRINTFN(6, "ifaceno=%d clockid=%d format=0x%08x\n",
+	    iface_no, clockid, format);
+
+	req.bmRequestType = UT_WRITE_CLASS_INTERFACE;
+	req.bRequest = UA20_CS_CUR;
+	USETW2(req.wValue, UA20_CS_AUDIO_FORMAT_CONTROL, 0);
+	USETW2(req.wIndex, clockid, iface_no);
+	USETW(req.wLength, 8);
+	/* USETDW(data,format); */
+	data[0] = format;
+	data[1] = format >> 8;
+	data[2] = format >> 16;
+	data[3] = format >> 24;
+	data[4] = 0;	/* format >> 32 */
+	data[5] = 0;	/* format >> 40 */
+	data[6] = 0;	/* format >> 48 */
+	data[7] = 0;	/* format >> 56 */
+
+	return (usbd_do_request(udev, NULL, &req, data));
+}
